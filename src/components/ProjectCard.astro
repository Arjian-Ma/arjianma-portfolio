---
interface ProjectLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  date: string;
  description: string;
  highlights?: string[];
  tags: string[];
  links?: ProjectLink[];
}

const { title, date, description, highlights = [], tags, links = [] } = Astro.props;
const previewHighlights = highlights.slice(0, 2);
---
<div class="card">
  <div class="card-header">
    <h3>{title}</h3>
    <span class="date">{date}</span>
  </div>

  <p class="description">{description}</p>

  {previewHighlights.length > 0 && (
    <ul class="highlights" aria-label={`${title} highlights`}>
      {previewHighlights.map(highlight => <li>{highlight}</li>)}
    </ul>
  )}

  <div class="tags">
    {tags.map(tag => <span>{tag}</span>)}
  </div>

  {links.length > 0 && (
    <div class="links">
      {links.map(link => {
        const isExternal = link.href.startsWith('http');
        return (
          <a
            href={link.href}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
          >
            {link.label}
            <span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
          </a>
        );
      })}
    </div>
  )}
</div>

<style>
  .card {
    background:
      radial-gradient(circle at top right, rgba(184, 92, 27, 0.13), transparent 38%),
      linear-gradient(145deg, rgba(255, 250, 244, 0.96), rgba(244, 226, 205, 0.78));
    border: 1px solid rgba(184, 92, 27, 0.18);
    border-radius: 14px;
    padding: 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    box-shadow: 0 10px 26px rgba(64, 45, 26, 0.06);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(184, 92, 27, 0.36);
    box-shadow: 0 16px 34px rgba(64, 45, 26, 0.13);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    gap: 0.75rem;
  }

  h3 {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.2;
  }

  .date {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    padding-top: 0.1rem;
  }

  p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .highlights {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .highlights li + li {
    margin-top: 0.35rem;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tags span {
    font-size: 0.78rem;
    background: var(--accent);
    color: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.55rem 0.8rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .links a:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }
</style>
