---
interface ProjectLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  date: string;
  description: string;
  highlights?: string[];
  tags: string[];
  links?: ProjectLink[];
}
const { title, date, description, highlights = [], tags, links = [] } = Astro.props;
---
<div class="card">
  <div class="card-header">
    <h3>{title}</h3>
    <span class="date">{date}</span>
  </div>
  <p>{description}</p>
  {highlights.length > 0 && (
    <ul class="highlights" aria-label={`${title} highlights`}>
      {highlights.map(highlight => <li>{highlight}</li>)}
    </ul>
  )}
  <div class="tags">
    {tags.map(tag => <span>{tag}</span>)}
  </div>
  {links.length > 0 && (
    <div class="links">
      {links.map(link => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    gap: 0.75rem;
  }
  h3 {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.2;
  }
  .date {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    padding-top: 0.1rem;
  }
  p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .highlights {
    margin: 0 0 1.1rem;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .highlights li + li { margin-top: 0.35rem; }
  .highlights li::marker { color: var(--accent); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .tags span {
    font-size: 0.78rem;
    background: var(--accent);
    color: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.55rem 0.8rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .links a:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }
</style>
