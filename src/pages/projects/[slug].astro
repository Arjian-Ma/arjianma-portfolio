---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const githubLink = project.links?.find(link => link.href.startsWith('http'));
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${project.title} | Jiantang Ma`} description={project.description} />
  </head>
  <body>
    <Header />
    <main class="project-detail">
      <a class="back-link" href="/projects/">← Back to Projects</a>

      <section class="hero-card">
        <div>
          <p class="eyebrow">Project · {project.date}</p>
          <h1>{project.title}</h1>
          <p class="overview">{project.overview}</p>
          <div class="tags" aria-label={`${project.title} technologies`}>
            {project.tags.map(tag => <span>{tag}</span>)}
          </div>
        </div>
        {githubLink && (
          <a class="github-button" href={githubLink.href} target="_blank" rel="noopener noreferrer">
            View GitHub ↗
          </a>
        )}
      </section>

      {project.images && project.images.length > 0 && (
        <section class="gallery" aria-label="Project visuals">
          {project.images.map(image => (
            <figure>
              <img src={image.src} alt={image.alt} loading="lazy" />
              <figcaption>{image.caption}</figcaption>
            </figure>
          ))}
        </section>
      )}

      {project.highlights && project.highlights.length > 0 && (
        <section class="content-card">
          <h2>Highlights</h2>
          <ul class="highlight-list">
            {project.highlights.map(highlight => <li>{highlight}</li>)}
          </ul>
        </section>
      )}

      {project.sections?.map(section => (
        <section class="content-card">
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
          {section.bullets && section.bullets.length > 0 && (
            <ul>
              {section.bullets.map(bullet => <li>{bullet}</li>)}
            </ul>
          )}
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>

<style>
  .project-detail {
    max-width: 980px;
    margin: 3.5rem auto 5rem;
    padding: 0 1.5rem;
  }
  .back-link {
    display: inline-flex;
    margin-bottom: 1.5rem;
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }
  .hero-card,
  .content-card,
  figure {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.06);
  }
  .hero-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
    padding: 2rem;
    margin-bottom: 2rem;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin: 0 0 1rem;
  }
  .overview {
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
    margin: 0 0 1.4rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags span {
    background: var(--accent);
    border-radius: 999px;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.32rem 0.75rem;
  }
  .github-button {
    border: 1px solid var(--accent);
    border-radius: 10px;
    color: var(--accent);
    font-weight: 800;
    padding: 0.75rem 1rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .github-button:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  figure {
    margin: 0;
    overflow: hidden;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
    background: #fdf8f2;
  }
  figcaption {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    padding: 1rem;
  }
  .content-card {
    padding: 1.7rem 2rem;
    margin-bottom: 1.25rem;
  }
  .content-card h2 {
    color: var(--accent);
    font-size: 1.45rem;
    margin: 0 0 0.85rem;
  }
  .content-card p,
  .content-card li {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }
  .content-card p { margin: 0; }
  .content-card ul {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
  }
  .content-card li + li { margin-top: 0.45rem; }
  .content-card li::marker { color: var(--accent); }
  .highlight-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem 1.2rem;
    list-style-position: outside;
  }
  @media (max-width: 720px) {
    .hero-card { grid-template-columns: 1fr; padding: 1.5rem; }
    .github-button { justify-self: start; }
    .content-card { padding: 1.4rem; }
  }
</style>
