---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { learnTopics, lastUpdated } from '../data/learn';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Learn With Me | Jiantang Ma"
      description="A curated learning page for mathematics, machine learning, and AI agents."
    />
  </head>
  <body>
    <Header />
    <main class="learn-page">
      <section class="hero">
        <p class="eyebrow">Reading notes · papers · GitHub projects</p>
        <h1>Learn With Me</h1>
        <p class="intro">
          A living page for papers, repositories, and ideas I am following in mathematics,
          machine learning, and AI agents. I use this as a public learning trail: what looks
          interesting, why it matters, and what I want to understand next.
        </p>
        <div class="topic-nav" aria-label="Learning topics">
          {learnTopics.map(topic => <a href={`#${topic.slug}`}>{topic.title}</a>)}
        </div>
        <p class="updated">Last curated: {lastUpdated}</p>
      </section>

      <section class="learning-principles" aria-label="How I use this page">
        <div>
          <span>01</span>
          <h2>Read actively</h2>
          <p>For each paper or repo, I focus on the core problem, assumptions, method, and what I can reuse.</p>
        </div>
        <div>
          <span>02</span>
          <h2>Connect ideas</h2>
          <p>I group resources by themes so math, ML, and agent systems can cross-pollinate each other.</p>
        </div>
        <div>
          <span>03</span>
          <h2>Build small</h2>
          <p>When a resource looks useful, the next step is a small experiment, reproduction, or note.</p>
        </div>
      </section>

      {learnTopics.map(topic => (
        <section class="topic-section" id={topic.slug}>
          <div class="topic-heading">
            <p class="eyebrow">{topic.subtitle}</p>
            <h2>{topic.title}</h2>
            <p>{topic.description}</p>
          </div>

          <div class="resource-grid">
            {topic.resources.map(resource => (
              <article class="resource-card">
                <div class="resource-meta">
                  <span>{resource.type}</span>
                  <time>{resource.date}</time>
                </div>
                <h3>{resource.title}</h3>
                <p>{resource.summary}</p>
                <div class="tags">
                  {resource.tags.map(tag => <span>{tag}</span>)}
                </div>
                <a href={resource.href} target="_blank" rel="noopener noreferrer">
                  Open {resource.source} ↗
                </a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>

<style>
  .learn-page {
    max-width: 980px;
    margin: 3.5rem auto 5rem;
    padding: 0 1.5rem;
  }
  .hero {
    background:
      radial-gradient(circle at top right, rgba(184, 92, 27, 0.16), transparent 36%),
      linear-gradient(145deg, rgba(255, 250, 244, 0.98), rgba(244, 226, 205, 0.82));
    border: 1px solid rgba(184, 92, 27, 0.2);
    border-radius: 22px;
    box-shadow: 0 16px 38px rgba(64, 45, 26, 0.08);
    padding: clamp(1.8rem, 5vw, 3rem);
    margin-bottom: 2rem;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 0.98;
    margin: 0 0 1rem;
  }
  .intro {
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
    max-width: 760px;
    margin: 0 0 1.5rem;
  }
  .topic-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .topic-nav a,
  .resource-card a {
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 800;
    padding: 0.55rem 0.9rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .topic-nav a:hover,
  .resource-card a:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }
  .updated {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .learning-principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .learning-principles div,
  .resource-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 10px 26px rgba(64, 45, 26, 0.05);
  }
  .learning-principles div {
    padding: 1.35rem;
  }
  .learning-principles span {
    color: var(--accent);
    font-weight: 900;
  }
  .learning-principles h2 {
    font-size: 1.05rem;
    margin: 0.35rem 0 0.5rem;
  }
  .learning-principles p {
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    margin: 0;
  }
  .topic-section {
    margin: 3rem 0;
    scroll-margin-top: 6rem;
  }
  .topic-heading {
    margin-bottom: 1.2rem;
  }
  .topic-heading h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 0.6rem;
  }
  .topic-heading p:last-child {
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 760px;
    margin: 0;
  }
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .resource-card {
    background:
      radial-gradient(circle at top right, rgba(184, 92, 27, 0.1), transparent 40%),
      linear-gradient(145deg, rgba(255, 250, 244, 0.96), rgba(246, 235, 221, 0.86));
    border-color: rgba(184, 92, 27, 0.16);
    display: flex;
    flex-direction: column;
    padding: 1.3rem;
  }
  .resource-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }
  .resource-meta span {
    background: var(--accent);
    border-radius: 999px;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.22rem 0.6rem;
  }
  .resource-meta time {
    color: var(--text-muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .resource-card h3 {
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }
  .resource-card p {
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 1.1rem;
  }
  .tags span {
    background: rgba(184, 92, 27, 0.1);
    border: 1px solid rgba(184, 92, 27, 0.16);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
  }
  .resource-card a {
    align-self: flex-start;
    border-radius: 10px;
    font-size: 0.86rem;
  }
  @media (max-width: 680px) {
    .learn-page { margin-top: 2rem; }
    .resource-meta { flex-direction: column; }
  }
</style>
